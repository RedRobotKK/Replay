# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Go
/vendor/
# Coverage artefacts, named exactly. `coverage.*` was the rule here and it
# matched at any depth, so internal/guardcheck/coverage.go — a source file —
# was silently untracked: it built locally because it sat on disk, and would
# have reached CI as a package missing a file.
coverage.out
coverage.html
coverage.txt

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local environment and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Node (docs tooling)
node_modules/

# Claude Code local settings
.claude/settings.local.json

# `go build -o ./replay`, which scripts/preflight.sh itself produces. Without
# this, one `git add -A` commits a 10 MB binary.
/replay

# Git worktrees for parallel agents: full clones of this repo, never source.
.claude/worktrees/

# Demo binaries are built on demand, never committed: a recording that
# picks up whatever is on PATH records the wrong software.
docs/demo/.replay-demo-bin
